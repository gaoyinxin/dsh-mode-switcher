{
  "name": "@gaoyinxin/dsh-mode-switcher",
  "version": "1.0.2",
  "description": "Switch between Plan and Build mode via Tab button or key, with per-mode preset models.",
  "author": "GaoYinxin",
  "homepage": "https://github.com/gaoyinxin/dsh-mode-switcher#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaoyinxin/dsh-mode-switcher.git"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "plan-mode",
    "build-mode",
    "model-switcher",
    "tab-shortcut"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "index.json",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
